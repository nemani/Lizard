{"version": 2, "width": 80, "height": 24, "timestamp": 1787266411, "env": {"SHELL": "/bin/zsh", "TERM": "dumb"}}
[0.100683, "o", "\r\n\u001b[1;32m🦎 Lizard demo: edge hardware monitoring over MQTT\u001b[0m\r\n"]
[1.105074, "o", "\r\n\u001b[1;32mStarting from nothing running. First, confirm the Docker Compose stack is stopped.\u001b[0m\r\n"]
[2.115372, "o", "\r\n\u001b[1;34m$ docker compose ps\u001b[0m\r\n"]
[2.482877, "o", "NAME      IMAGE     COMMAND   SERVICE   CREATED   STATUS    PORTS\r\n"]
[3.491712, "o", "\r\n\u001b[1;32mBring up the central Nest stack: MQTT, Nest API/UI, Prometheus, and Grafana.\u001b[0m\r\n"]
[4.510887, "o", "\r\n\u001b[1;34m$ docker compose up -d mqtt nest prometheus grafana\u001b[0m\r\n"]
[4.708632, "o", "\u001b[?25l\u001b[0G[+] up 0/1\r\n"]
[4.709275, "o", " ⠋ Container lizard-mqtt-1 Starting                                         0.1s\r\n\u001b[?25h"]
[4.807609, "o", "\u001b[?25l\u001b[2A\u001b[0G[+] up 1/2\r\n ✔ Container lizard-mqtt-1 Started                                          0.2s\r\n ⠋ Container lizard-nest-1 Starting                                         0.0s\r\n\u001b[?25h"]
[4.908153, "o", "\u001b[?25l\u001b[3A\u001b[0G[+] up 2/3\r\n ✔ Container lizard-mqtt-1       Started                                    0.2s\r\n ✔ Container lizard-nest-1       Started                                    0.1s\r\n ⠋ Container lizard-prometheus-1 Starting                                   0.0s\r\n\u001b[?25h"]
[5.009657, "o", "\u001b[?25l\u001b[4A\u001b[0G[+] up 3/4\r\n ✔ Container lizard-mqtt-1       Started                                    0.2s\r\n ✔ Container lizard-nest-1       Started                                    0.1s\r\n ✔ Container lizard-prometheus-1 Started                                    0.1s\r\n ⠋ Container lizard-grafana-1    Starting                                   0.0s\r\n\u001b[?25h"]
[5.108745, "o", "\u001b[?25l\u001b[5A\u001b[0G[+] up 3/4\r\n ✔ Container lizard-mqtt-1       Started                                    0.2s\r\n ✔ Container lizard-nest-1       Started                                    0.1s\r\n ✔ Container lizard-prometheus-1 Started                                    0.1s\r\n ⠙ Container lizard-grafana-1    Starting                                   0.1s\r\n\u001b[?25h"]
[5.114069, "o", "\u001b[?25l\u001b[5A\u001b[0G[+] up 4/4\r\n ✔ Container lizard-mqtt-1       Started                                    0.2s\r\n ✔ Container lizard-nest-1       Started                                    0.1s\r\n ✔ Container lizard-prometheus-1 Started                                    0.1s\r\n ✔ Container lizard-grafana-1    Started                                    0.1s\r\n\u001b[?25h"]
