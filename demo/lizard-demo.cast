[6.286706, "o", "NAME                  IMAGE                     COMMAND                  SERVICE      CREATED          STATUS        PORTS\r\nlizard-grafana-1      grafana/grafana:11.3.1    \"/run.sh\"                grafana      4 hours ago      Up 1 second"]
[6.286738, "o", "   0.0.0.0:3000->3000/tcp, [::]:3000->3000/tcp\r\nlizard-mqtt-1         eclipse-mosquitto:2       \"/docker-entrypoint.…\"   mqtt         4 hours ago      Up 1 second   0.0.0.0:1884->1883/tcp, [::]:1884->1883/tcp\r\nlizard-nest-1         lizard-nest               \"lizard-nest\"            nest         37 minutes ago   Up 1 second   0.0.0.0:8000->8000/tcp, [::]:8000->8000/tcp\r\nlizard-prometheus-1   prom/prometheus:v2.55.1   \"/bin/prometheus --c…\"   prometheus   4 hours ago      Up 1 second   0.0.0.0:9090->9090/tcp, [::]:9090->9090/tcp\r\n"]
[7.301103, "o", "\r\n\u001b[1;32mCheck Nest health from inside the container.\u001b[0m\r\n"]
[8.316178, "o", "\r\n\u001b[1;34m$ docker compose exec -T nest python -c from urllib.request import urlopen; print(urlopen('http://127.0.0.1:8000/health').read().decode())\u001b[0m\r\n"]
[8.681459, "o", "{\"status\":\"ok\"}\r\n"]
[9.70597, "o", "\r\n\u001b[1;32mNow start three test eggs. Production eggs are installed on Ubuntu GPU hosts as systemd services.\u001b[0m\r\n"]
[10.719927, "o", "\r\n\u001b[1;34m$ docker compose --profile test-hosts up -d --scale egg-test=3 egg-test\u001b[0m\r\n"]
[10.932053, "o", "\u001b[?25l\u001b[0G[+] up 1/2\r\n"]
[10.932309, "o", " ✔ Container lizard-mqtt-1     Running                                      0.0s\r\n ⠋ Container lizard-egg-test-2 Starting                                     0.1s\r\n\u001b[?25h"]
[11.032027, "o", "\u001b[?25l\u001b[3A\u001b[0G[+] up 2/3\r\n ✔ Container lizard-mqtt-1     Running                                      0.0s\r\n ✔ Container lizard-egg-test-2 Started                                      0.1s\r\n ⠋ Container lizard-egg-test-1 Starting                                     0.0s\r\n\u001b[?25h"]
[11.132167, "o", "\u001b[?25l\u001b[4A\u001b[0G[+] up 3/4\r\n ✔ Container lizard-mqtt-1     Running                                      0.0s\r\n ✔ Container lizard-egg-test-2 Started                                      0.1s\r\n ✔ Container lizard-egg-test-1 Started                                      0.1s\r\n ⠋ Container lizard-egg-test-3 Starting                                     0.0s\r\n\u001b[?25h"]
[11.189821, "o", "\u001b[?25l\u001b[5A\u001b[0G[+] up 4/4\r\n ✔ Container lizard-mqtt-1     Running                                      0.0s\r\n ✔ Container lizard-egg-test-2 Started                                      0.1s\r\n ✔ Container lizard-egg-test-1 Started                                      0.1s\r\n ✔ Container lizard-egg-test-3 Started                                      0.1s\r\n\u001b[?25h"]
[12.201959, "o", "\r\n\u001b[1;32mGive the eggs a few seconds to publish inventory and metrics.\u001b[0m\r\n"]
[21.235286, "o", "\r\n\u001b[1;32mShow heartbeat state: online/stale/offline counts and last-seen tracking.\u001b[0m\r\n"]
[22.252134, "o", "\r\n\u001b[1;34m$ docker compose exec -T nest python -c from urllib.request import urlopen; import json; statuses=json.load(urlopen('http://127.0.0.1:8000/servers/status')); counts={}; [counts.__setitem__(s['state'], counts.get(s['state'], 0)+1) for s in statuses]; online=[s for s in statuses if s['state']=='online']; print('state counts:', counts); print('currently online:', len(online)); print('sample online status:', online[0] if online else 'none')\u001b[0m\r\n"]
[22.628595, "o", "state counts: {'offline': 21, 'online': 3}\r\ncurrently online: 3\r\nsample online status: {'host_id': '346970b1702a', 'hostname': '346970b1702a', 'last_seen': '2026-08-20T22:53:52.874429Z', 'age_seconds': 1.011351, 'state': 'online', 'uptime_seconds': 10.055205, 'alert_count': 1, 'critical_alert_count': 0}\r\n"]
[23.642845, "o", "\r\n\u001b[1;32mShow one latest metrics payload summary: CPU, per-core CPU count, RAM, disks, GPUs, alerts.\u001b[0m\r\n"]
[24.660094, "o", "\r\n\u001b[1;34m$ docker compose exec -T nest python -c from urllib.request import urlopen; import json; statuses=json.load(urlopen('http://127.0.0.1:8000/servers/status')); online_ids={s['host_id'] for s in statuses if s['state']=='online'}; servers=json.load(urlopen('http://127.0.0.1:8000/servers')); host=next((s for s in servers if s['host_id'] in online_ids), servers[0]); print('host_id:', host['host_id']); print('cpu overall:', host['cpu']['overall_percent']); print('cpu cores:', len(host['cpu']['per_core_percent'])); print('memory percent:', host['memory']['percent']); print('disk devices:', [d['device'] for d in host['disks']]); print('gpus:', len(host['gpus'])); print('alerts:', host['alerts'])\u001b[0m\r\n"]
[24.970096, "o", "host_id: 346970b1702a\r\ncpu overall: 3.4\r\ncpu cores: 8\r\nmemory percent: 10.2\r\ndisk devices: ['/dev/vdb1']\r\ngpus: 0\r\nalerts: [{'level': 'warning', 'metric': 'cpu.overall_percent', 'message': 'cpu.overall_percent is 3.4, above warning threshold 1.0', 'value': 3.4, 'threshold': 1.0}]\r\n"]
[25.988326, "o", "\r\n\u001b[1;32mShow Prometheus-format metrics exported by Nest.\u001b[0m\r\n"]
[27.003176, "o", "\r\n\u001b[1;34m$ docker compose exec -T nest python -c from urllib.request import urlopen; lines=urlopen('http://127.0.0.1:8000/metrics').read().decode().splitlines(); print('\\n'.join(lines[:18]))\u001b[0m\r\n"]
[27.325369, "o", "# HELP lizard_cpu_percent Overall CPU usage percent.\r\n# TYPE lizard_cpu_percent gauge\r\nlizard_cpu_percent{host_id=\"003dddfd1e04\",hostname=\"003dddfd1e04\"} 11.3\r\nlizard_cpu_core_percent{host_id=\"003dddfd1e04\",hostname=\"003dddfd1e04\",core=\"0\"} 46.9\r\nlizard_cpu_core_percent{host_id=\"003dddfd1e04\",hostname=\"003dddfd1e04\",core=\"1\"} 10.1\r\nlizard_cpu_core_percent{host_id=\"003dddfd1e04\",hostname=\"003dddfd1e04\",core=\"2\"} 1.8\r\nlizard_cpu_core_percent{host_id=\"003dddfd1e04\",hostname=\"003dddfd1e04\",core=\"3\"} 7.0\r\nlizard_cpu_core_percent{host_id=\"003dddfd1e04\",hostname=\"003dddfd1e04\",core=\"4\"} 7.7\r\nlizard_cpu_core_percent{host_id=\"003dddfd1e04\",hostname=\"003dddfd1e04\",core=\"5\"} 2.7\r\nlizard_cpu_core_percent{host_id=\"003dddfd1e04\",hostname=\"003dddfd1e04\",core=\"6\"} 1.3\r\nlizard_cpu_core_percent{host_id=\"003dddfd1e04\",hostname=\"003dddfd1e04\",core=\"7\"} 0.0\r\nlizard_memory_percent{host_id=\"003dddfd1e04\",hostname=\"003dddfd1e04\"} 10.3\r\nlizard_memory_used_bytes{host_id=\"003dddfd1e04\",hostname=\"003dddfd1e04\"} 863842304\r\nlizard_agent_u"]
[27.325509, "o", "ptime_seconds{host_id=\"003dddfd1e04\",hostname=\"003dddfd1e04\"} 305.216983\r\nlizard_disk_percent{host_id=\"003dddfd1e04\",hostname=\"003dddfd1e04\",mountpoint=\"/etc/resolv.conf\",device=\"/dev/vdb1\"} 8.5\r\nlizard_disk_total_bytes{host_id=\"003dddfd1e04\",hostname=\"003dddfd1e04\",mountpoint=\"/etc/resolv.conf\",device=\"/dev/vdb1\"} 147236847616\r\nlizard_disk_used_bytes{host_id=\"003dddfd1e04\",hostname=\"003dddfd1e04\",mountpoint=\"/etc/resolv.conf\",device=\"/dev/vdb1\"} 12584148992\r\nlizard_disk_free_bytes{host_id=\"003dddfd1e04\",hostname=\"003dddfd1e04\",mountpoint=\"/etc/resolv.conf\",device=\"/dev/vdb1\"} 134652698624\r\n"]
[28.344472, "o", "\r\n\u001b[1;32mPush retained global config through the Nest API: 5 second interval and low CPU warning threshold.\u001b[0m\r\n"]
[29.363137, "o", "\r\n\u001b[1;34m$ docker compose exec -T nest python -c from urllib.request import Request, urlopen; import json; payload=json.dumps({'interval_seconds':5,'cpu_percent_thresholds':[{'level':'warning','value':1},{'level':'critical','value':90}]}).encode(); req=Request('http://127.0.0.1:8000/config/global', data=payload, headers={'content-type':'application/json'}, method='POST'); print(urlopen(req).read().decode())\u001b[0m\r\n"]
[29.698596, "o", "{\"scope\":\"global\",\"version\":3,\"updated_at\":\"2026-08-20T22:54:00.956916Z\",\"config\":{\"interval_seconds\":5,\"cpu_percent_thresholds\":[{\"level\":\"warning\",\"value\":1.0},{\"level\":\"critical\",\"value\":90.0}],\"memory_percent_thresholds\":null,\"disk_percent_thresholds\":null,\"gpu_percent_thresholds\":null,\"temperature_celsius_thresholds\":null}}\r\n"]
[30.713428, "o", "\r\n\u001b[1;32mWait for eggs to receive config and publish ack/status.\u001b[0m\r\n"]
[39.744573, "o", "\r\n\u001b[1;32mRead config acknowledgements from Nest.\u001b[0m\r\n"]
[40.762236, "o", "\r\n\u001b[1;34m$ docker compose exec -T nest python -c from urllib.request import urlopen; import json; statuses=json.load(urlopen('http://127.0.0.1:8000/servers/status')); online_ids={s['host_id'] for s in statuses if s['state']=='online'}; acks=json.load(urlopen('http://127.0.0.1:8000/config/acks')); current={host_id: ack for host_id, ack in acks.items() if host_id in online_ids}; print(json.dumps(current, indent=2)[:1400])\u001b[0m\r\n"]
[41.231169, "o", "{\r\n  \"346970b1702a\": {\r\n    \"host_id\": \"346970b1702a\",\r\n    \"hostname\": \"346970b1702a\",\r\n    \"scope\": \"global\",\r\n    \"version\": 3,\r\n    \"active_scope\": \"global\",\r\n    \"active_version\": 3,\r\n    \"status\": \"applied\",\r\n    \"message\": \"config received\",\r\n    \"timestamp\": \"2026-08-20T22:54:00.961060Z\"\r\n  },\r\n  \"5298245ef76b\": {\r\n    \"host_id\": \"5298245ef76b\",\r\n    \"hostname\": \"5298245ef76b\",\r\n    \"scope\": \"global\",\r\n    \"version\": 3,\r\n    \"active_scope\": \"global\",\r\n    \"active_version\": 3,\r\n    \"status\": \"applied\",\r\n    \"message\": \"config received\",\r\n    \"timestamp\": \"2026-08-20T22:54:00.959071Z\"\r\n  },\r\n  \"5dccf7702235\": {\r\n    \"host_id\": \"5dccf7702235\",\r\n    \"hostname\": \"5dccf7702235\",\r\n    \"scope\": \"global\",\r\n    \"version\": 3,\r\n    \"active_scope\": \"global\",\r\n    \"active_version\": 3,\r\n    \"status\": \"applied\",\r\n    \"message\": \"config received\",\r\n    \"timestamp\": \"2026-08-20T22:54:00.958983Z\"\r\n  }\r\n}\r\n"]
[42.251713, "o", "\r\n\u001b[1;32mDemo endpoints:\u001b[0m\r\n"]
[43.266215, "o", "Nest UI:       http://localhost:8000\r\n"]
[43.26637, "o", "Prometheus:    http://localhost:9090\r\nGrafana:       http://localhost:3000  (admin / lizard)\r\n"]
[44.282189, "o", "\r\n\u001b[1;32mDone. This terminal recording covers the running prototype; the browser UI and Grafana dashboards are available at the URLs above.\u001b[0m\r\n"]
